# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application encryption for Brightspace URL and Google refresh token ciphertext (min 32 chars)
SECRETS_ENCRYPTION_KEY=

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials
# Must match the OAuth client configured in Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# n8n webhook URL to trigger a manual sync (optional — leave blank to disable the trigger endpoint)
N8N_WEBHOOK_URL=
